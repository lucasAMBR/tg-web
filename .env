# Usados só pelo docker-compose (o Vite só expõe as variáveis VITE_*)
# UID/GID do host, para os arquivos gerados no container serem do seu usuário
UID=1000
GID=1000
# Porta do front no PC (a padrão do Vite). Se estiver em uso, troque aqui (ver o README)
FORWARD_WEB_PORT=5173

VITE_APP_NAME=Brew

# API do tg-api no Docker. Se mudar FORWARD_APP_PORT no .env do tg-api, troque a porta aqui
VITE_STORAGE_URL="http://localhost:18000/storage"
VITE_API_BASE_URL="http://localhost:18000/api"
VITE_API_SWAGGER_URL="http://localhost:18000/docs/api.json"

VITE_TOKEN_STORAGE_KEY="brew@tkn"
VITE_REFRESH_TOKEN_STORAGE_KEY="brew@rtkn"

VITE_AWESOME_API_URL="https://cep.awesomeapi.com.br/json/"
VITE_AWESOME_API_KEY="sk_gSiiknlHqNOq5rk6zyj5z3K-upi4ilT-7LIf4niEoK70WXm1n5ec2eZhUEBzx"

# Reverb do tg-api no Docker: a chave é a REVERB_APP_KEY e as portas WS/WSS são a
# FORWARD_REVERB_PORT do .env do tg-api. A VITE_WS_AUTH_ENDPOINT usa a porta da API
VITE_WS_KEY=tg-api-key
VITE_WS_HOST=localhost
VITE_WS_PORT=18080
VITE_WSS_PORT=18080
VITE_WS_FORCE_TLS=false
VITE_WS_AUTH_ENDPOINT=http://localhost:18000/api/broadcasting/auth
